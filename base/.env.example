# ============================================================
# CRM Multicanal · variables de entorno
# Copiá este archivo a .env.local y completá. Nunca lo subas a Git.
# Ningún secreto se pasa por chat: se escriben acá y en el panel de Vercel.
# ============================================================

# --- Base de datos (Supabase) ---
# Project Settings → Database → Connection string → "Transaction pooler".
# Tiene que ser el pooler (puerto 6543), no la conexión directa: en serverless
# una conexión por invocación agota la base.
DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-xx.pooler.supabase.com:6543/postgres

# --- Proveedor de canales (Zernio) ---
# Usá una clave RESTRINGIDA (zrk_) con los grupos: messages, accounts, webhooks.
# Una clave completa (sk_) da acceso a publicar, anuncios y facturación: no hace falta.
ZERNIO_API_KEY=zrk_...
ZERNIO_API_URL=https://zernio.com/api

# Secreto del webhook. Generalo con: openssl rand -hex 32
# SIN ESTO EL CRM NO RECIBE NADA, a propósito: la firma del proveedor es opcional,
# así que sin secreto rechazamos todo en vez de aceptar todo.
ZERNIO_WEBHOOK_SECRET=

# --- El modelo del agente (OpenRouter) ---
# Una sola credencial para todos los modelos. La cuenta y la key son gratis; el saldo
# lo cargás vos. NO uses modelos ":free": se saturan y devuelven 429 en producción.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# --- Login (Supabase Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Acceso total a la base: tratala como una contraseña. SOLO del lado del servidor.
# Nunca la pongas en una variable NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Barridos de recuperación ---
# Protege el endpoint que levanta eventos reclamados y sin procesar.
# Generalo con: openssl rand -hex 32
CRON_SECRET=

# --- Guardrails (opcional pero muy recomendado) ---
# Código canario: una cadena única y secreta. Si aparece en una respuesta del agente,
# el mensaje se bloquea (el modelo estaría filtrando su prompt).
CODIGO_CANARIO=

# --- Sistema externo del cliente (opcional) ---
# "ejemplo" usa el adaptador ficticio del kit, que funciona sin red ni credenciales.
# Cambialo por el nombre de tu adaptador cuando conectes el sistema real.
SISTEMA_EXTERNO=ejemplo

# --- Producción ---
# NO agregues APP_BASE_URL. El host sale del request. Una URL fija mal puesta hace
# que el agente no conteste nunca, sin un solo error visible en ningún lado.
LOG_LEVEL=info
